# Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# --- Database ---
# Leave blank to use local SQLite (backend/data/studyforge.db)
# Set to a Postgres URL for production (Railway / Supabase)
DATABASE_URL=

# --- Supabase (only needed when AUTH_ENABLED=true) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Auth ---
# Set to true to enforce Supabase JWT auth on all routes
AUTH_ENABLED=false

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# --- ChromaDB (optional vector store) ---
CHROMADB_PATH=./data/chroma

# --- Frontend URL (used in email links etc.) ---
FRONTEND_URL=http://localhost:5173

# --- Pluggable Embeddings (Phase 6) ---
# Set to true to use sentence-transformers instead of TF-IDF
# Requires: pip install sentence-transformers
USE_SENTENCE_TRANSFORMERS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
